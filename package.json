{
  "name": "suggested-notes-plugin",
  "version": "0.6.1",
  "description": "Sidebar plugin for Obsidian that suggests related notes based on shared tags, links, and content words.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "suggested-notes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20.11.0",
    "@types/pluralize": "^0.0.33",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "pluralize": "^8.0.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  }
}
